# Neon Postgres 연결 문자열 — 이 파일은 커밋된다. 실제 값을 절대 넣지 않는다.
#
# 사용법: 이 파일을 .env로 복사한 뒤 .env에만 실제 값을 채운다.
#   cp .env.example .env
#
# 두 개가 필요한 이유:
#   DATABASE_URL — pooled(호스트에 "-pooler"). 앱 런타임 쿼리용.
#                  Vercel 서버리스 함수가 동시에 많이 뜨므로 connection pooling이 필요하다.
#   DIRECT_URL   — direct(호스트에 "-pooler"가 없다). prisma migrate / db push 용.
#                  pooled URL로 마이그레이션을 돌리면 실패한다.
#
# Neon 콘솔 > 프로젝트 > Connect 에서 두 문자열을 그대로 복사한다.
# 호스트명을 직접 조립하지 말고 콘솔에서 복사한 문자열을 통째로 쓴다.
# 구분 기준은 호스트명의 "-pooler" 유무다.

DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# 백엔드 API (분리 이후)
# apps/web 의 서버 계층만 이 값을 읽는다. 브라우저에는 내려가지 않는다(BFF 구조).
KPI_API_URL="http://localhost:4000"
# 서비스 간 인증 키. 로컬에서는 비워 두면 apps/api가 검증을 건너뛴다.
# 배포 환경에서는 apps/api 의 API_KEY 와 같은 값으로 반드시 설정한다.
KPI_API_KEY=""
API_KEY=""
