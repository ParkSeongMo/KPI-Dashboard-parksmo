# 모노레포다. 패턴 앞에 `/`를 붙이면 저장소 루트에만 적용되어
# apps/*, packages/* 하위 산출물이 걸러지지 않는다. 의도적으로 anchor 하지 않는다.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

# next.js
.next/
out/

# build output
build/
dist/
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 연결 문자열은 절대 커밋하지 않는다.
# .env.example만 예외로 커밋한다(키 이름만 담는다).
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code 로컬 권한/설정 — .example만 커밋한다
.claude/settings.local.json

# 스캐폴딩 임시 디렉터리 — 하네스 템플릿 원본이라 이 저장소에는 커밋하지 않는다
/tmp-scaffold
/template
